{% assign delivery_method_types = delivery_agreements | map: 'delivery_method_type' | uniq %}
{% assign has_split_cart = false %}
{% assign non_none_count = 0 %}
{% for type in delivery_method_types %}
  {% unless type == 'none' %}
    {% assign non_none_count = non_none_count | plus: 1 %}
  {% endunless %}
{% endfor %}
{% if non_none_count > 1 %}
  {% assign has_split_cart = true %}
{% endif %}

{% assign non_none_agreements_count = 0 %}
{% for agreement in delivery_agreements %}
  {% unless agreement.delivery_method_type == 'none' %}
    {% assign non_none_agreements_count = non_none_agreements_count | plus: 1 %}
  {% endunless %}
{% endfor %}

{% capture email_title %}
  {% if customer.first_name != blank %}
    Merci {{ customer.first_name }} !
  {% else %}
    Merci pour votre commande !
  {% endif %}
{% endcapture %}
{% capture email_body %}
  {% if has_pending_payment %}
    {% if buyer_action_required %}
      Vous recevrez un e‑mail de confirmation après avoir effectué votre paiement.
    {% else %}
      Votre paiement est en cours de traitement. Vous recevrez un e‑mail lorsque votre commande sera confirmée.
    {% endif %}
  {% elsif payment_charged_on_fulfillment %}
    Bonjour {{ customer.first_name }}, nous avons bien reçu votre commande. Votre moyen de paiement sera débité lorsque votre commande sera prête à être traitée. Nous vous informerons dès qu’elle sera en route.
  {% else %}
    Voici le récapitulatif de votre commande ainsi que vos informations de livraison et de paiement.
    {% if requires_shipping %}
      {% if has_split_cart %}
        {% case split_cart_delivery_method %}
          {% when 'pick-up' %}
            Nous vous préviendrons dès que votre commande sera prête à être récupérée.
          {% when 'local' %}
            Nous préparons votre commande pour sa livraison.
          {% when 'shipping' %}
            Nous préparons votre commande. Vous recevrez un e-mail dès qu’elle sera expédiée.
          {% else %}
            Nous préparons votre commande. Vous recevrez un e-mail dès qu’elle sera expédiée.
        {% endcase %}
      {% else %}
        {% case delivery_method %}
          {% when 'pick-up' %}
            Nous vous préviendrons dès que votre commande sera prête à être récupérée.
          {% when 'local' %}
            Nous préparons votre commande pour sa livraison.
          {% else %}
            Nous préparons votre commande. Vous recevrez un e-mail dès qu’elle sera expédiée.
        {% endcase %}
      {% endif %}
        {% if delivery_instructions != blank  %}
          <p><b>Informations sur la livraison :</b> {{ delivery_instructions }}</p>
        {% endif %}
      {% unless delivery_method_types.size > 1 %}
        {% if consolidated_estimated_delivery_time %}
          {% if non_none_agreements_count > 1 %}
            <h3 class="estimated_delivery__title">Date de livraison estimée</h3>
            <p>{{ consolidated_estimated_delivery_time }}</p>
          {% else %}
            <p>
              Date de livraison estimée <b>{{ consolidated_estimated_delivery_time }}</b>
            </p>
          {% endif %}
        {% endif %}
      {% endunless %}
    {% endif %}
  {% endif %}
  {% assign gift_card_line_items = line_items | where: "gift_card" %}
  {% assign found_gift_card_with_recipient_email = false %}
  {% for line_item in gift_card_line_items %}
    {% if line_item.properties["__shopify_send_gift_card_to_recipient"] and line_item.properties["Recipient email"] %}
      {% assign found_gift_card_with_recipient_email = true %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if found_gift_card_with_recipient_email %}
    <p>Le/la bénéficiaire de votre carte‑cadeau recevra un e‑mail contenant le code de sa carte‑cadeau.</p>
  {% elsif gift_card_line_items.first %}
    <p>Vous recevrez des e-mails distincts pour toutes les cartes-cadeaux.</p>
  {% endif %}
{% endcapture %}

<!DOCTYPE html>
<html lang="fr">
  <head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    /*
      Mileyo Order Confirmation — single main card shell.
      Shopify repeats .container per section; those stay transparent width wrappers.
      Only .mileyo-main-card is the white surface.
    */
    body, .body {
      background-color: #FCF8F6 !important;
      color: #3A2C45 !important;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .body > tr > td {
      padding: 24px 12px !important;
    }
    .mileyo-main-card {
      background-color: #FFFFFF !important;
      border: 0 !important;
      border-radius: 16px !important;
      box-shadow: none !important;
      margin: 0 auto !important;
      max-width: 600px !important;
      width: 100% !important;
    }
    .mileyo-main-card__inner {
      padding: 0 !important;
    }
    /* Section cells inside the main card: no autonomous white cards */
    .mileyo-main-card .header,
    .mileyo-main-card .content,
    .mileyo-main-card .section,
    .mileyo-main-card .header__cell,
    .mileyo-main-card .content__cell,
    .mileyo-main-card .section__cell {
      background-color: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
    }
    .mileyo-main-card .header__cell { padding: 24px 24px 12px !important; }
    .mileyo-main-card .content__cell { padding: 4px 24px 30px !important; }
    .mileyo-main-card .section__cell {
      border-top: 1px solid #E8D9F2 !important;
      padding: 32px 24px 28px !important;
    }
    .footer__cell {
      background-color: #FCF8F6 !important;
      border: 0 !important;
      padding: 20px 16px !important;
    }
    /* Width wrappers only — NOT cards */
    table.container, .container {
      background-color: transparent !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      max-width: 100% !important;
      outline: none !important;
      width: 100% !important;
    }
    h2, h3, .shop-name__text {
      color: #5A1B69 !important;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif !important;
      font-weight: 700 !important;
      letter-spacing: -0.02em !important;
    }
    h2 { font-size: 24px !important; line-height: 30px !important; margin: 0 0 10px !important; }
    /* Section titles: 32px via section__cell padding-top; 20px below title */
    h3 { font-size: 20px !important; line-height: 26px !important; margin: 0 0 20px !important; }
    h4 {
      color: #5A1B69 !important;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif !important;
      font-size: 15px !important;
      font-weight: 700 !important;
      letter-spacing: -0.02em !important;
      margin: 0 0 8px !important;
    }
    p { color: #3A2C45 !important; font-size: 15px !important; line-height: 22px !important; margin: 0 0 10px !important; }
    a, a:hover, a:active, a:visited { color: #5A1B69 !important; }
    .mileyo-logo { display: block; margin: 0 auto 8px; max-width: 120px; height: auto; width: 120px; }
    .mileyo-header { text-align: center !important; padding: 0 !important; }
    .order-number__text, .po-number__text, .disclaimer__subtext, .mileyo-order-ref {
      color: #6F5A7D !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      letter-spacing: 0.02em;
    }
    .mileyo-order-ref { display: block; margin: 8px auto 0; text-align: center; }
    /* Kill Shopify empty-line spacer that creates huge vertical gaps */
    .empty-line,
    td.empty-line {
      display: none !important;
      font-size: 0 !important;
      height: 0 !important;
      line-height: 0 !important;
      padding: 0 !important;
    }
    .actions { margin: 0 !important; }
    /* Intro → CTA ~20–24px (p margin + padding-top) */
    .actions__cell { padding: 14px 0 0 !important; text-align: center !important; }
    /* Shop → Visiter la boutique ~16–18px */
    .actions__group { margin-top: 16px !important; }
    /* Shared CTA outer size — both buttons identical footprint */
    .button__cell,
    .actions-buttons .button__cell--primary,
    .main-action-cell .button__cell,
    .button__cell--shop-app {
      border: 0 !important;
      border-radius: 28px !important;
      box-sizing: border-box !important;
      display: inline-block !important;
      height: 46px !important;
      max-width: 200px !important;
      min-width: 200px !important;
      padding: 0 !important;
      text-align: center !important;
      vertical-align: middle !important;
      width: 200px !important;
    }
    .button__cell,
    .actions-buttons .button__cell--primary,
    .main-action-cell .button__cell {
      background: #5A1B69 !important;
      background-color: #5A1B69 !important;
    }
    .button__text,
    .button__text--shop-app {
      box-sizing: border-box !important;
      display: inline-block !important;
      font-size: 14px !important;
      height: 46px !important;
      line-height: 46px !important;
      max-width: 200px !important;
      min-width: 200px !important;
      padding: 0 12px !important;
      text-align: center !important;
      text-decoration: none !important;
      vertical-align: middle !important;
      width: 200px !important;
    }
    .button__text {
      color: #FFFFFF !important;
      font-weight: 700 !important;
    }
    /* Shop secondary: same size, softer fill; white Shop logo stays readable */
    .button__cell--shop-app {
      background: #7B4A8A !important;
      background-color: #7B4A8A !important;
      opacity: 1;
    }
    .button__text--shop-app {
      color: #FFFFFF !important;
      font-weight: 600 !important;
    }
    .button__shop-logo {
      display: inline-block !important;
      margin-left: 4px !important;
      vertical-align: middle !important;
    }
    .actions-buttons {
      margin: 0 auto !important;
      width: 200px !important;
    }
    .actions-buttons td { text-align: center !important; }
    /* CTA principal → Shop ~10–12px */
    .button__cell--separator {
      font-size: 12px !important;
      height: 12px !important;
      line-height: 12px !important;
      width: 200px !important;
    }
    .main-action-cell { margin: 0 auto !important; width: 200px !important; }
    .link__cell, .secondary-action-cell, .mileyo-store-link {
      color: #6F5A7D !important;
      font-size: 14px !important;
    }
    .mileyo-store-link a {
      color: #6F5A7D !important;
      font-weight: 500 !important;
      text-decoration: none !important;
    }
    /* Customer mini-cards: shared gap via border-spacing on .customer-info-row */
    .customer-info-row {
      border-collapse: separate !important;
      border-spacing: 14px 14px !important;
      margin: 0 !important;
      width: 100% !important;
    }
    .customer-info__item {
      background-color: #FCF8F6 !important;
      border: 1px solid #E8D9F2 !important;
      border-radius: 12px !important;
      padding: 14px 16px !important;
      vertical-align: top !important;
    }
    .order-list__delivery-method-type-separator, hr {
      border: 0 !important;
      border-top: 1px solid #E8D9F2 !important;
      margin: 16px 0 !important;
    }
    @media only screen and (max-width: 480px) {
      .mileyo-main-card .header__cell,
      .mileyo-main-card .content__cell,
      .mileyo-main-card .section__cell { padding-left: 18px !important; padding-right: 18px !important; }
      .actions-buttons,
      .main-action-cell,
      .button__cell,
      .button__cell--shop-app,
      .button__text,
      .button__text--shop-app,
      .button__cell--separator {
        display: block !important;
        max-width: 100% !important;
        min-width: 100% !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      .customer-info-row {
        border-spacing: 0 14px !important;
      }
      .customer-info__item {
        display: block !important;
        width: 100% !important;
      }
    }
  </style>
</head>

