// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MealBox {
  id                     String   @id @default(cuid())
  shop                   String
  name                   String
  meals                  Int
  oneTimePriceCents      Int
  subscriptionPriceCents Int
  active                 Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AppSettings {
  id                          String   @id @default(cuid())
  shop                        String   @unique
  boxCollectionId             String?
  boxCollectionHandle         String?
  boxCollectionTitle          String?
  mealCollectionId            String?
  mealCollectionHandle        String?
  mealCollectionTitle         String?
  subscriptionDiscountPercent Float?   @default(20)
  supportChatUrl              String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model BoxOrder {
  id                      String   @id @default(cuid())
  shop                    String
  shopifyOrderId          String
  shopifyOrderName        String?
  customerEmail           String?
  customerName            String?
  orderType               String?
  boxTitle                String?
  mealsCount              Int?
  selectedMeals           Json?
  financialStatus         String?
  fulfillmentStatus       String?
  rawOrder                Json?
  selectedMealsSource     String?  @default("line_item_properties")
  isSubscriptionRenewal   Boolean  @default(false)
  subscriptionSelectionId String?
  subscriptionContractId  String?
  simulated               Boolean  @default(false)
  desiredDeliveryDate     String?  @db.VarChar(10)
  scheduledDeliveryDate   String?  @db.VarChar(10)
  deliveryRescheduleReason  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([shop, shopifyOrderId])
  @@index([shop, scheduledDeliveryDate])
}

model SubscriptionMealSelection {
  id                       String    @id @default(cuid())
  shop                     String
  customerShopifyId        String?
  customerEmail            String?
  subscriptionContractId   String?
  shopifyOrderId           String
  shopifyOrderName         String?
  boxTitle                 String?
  boxProductShopifyId      String?
  boxVariantShopifyId      String?
  boxSubscriptionPrice     String?
  boxSellingPlanShopifyId  String?
  mealsCount               Int?
  selectedMeals            Json?
  status                   String    @default("active")
  active                   Boolean   @default(true)
  nextBillingDate          DateTime?
  lastBillingAttemptAt            DateTime?
  lastBillingAttemptStatus        String?
  lastBillingAttemptError         String?
  lastBillingAttemptId            String?
  resumeAttemptKey                String?
  resumeAttemptStatus             String?
  resumeAttemptStartedAt          DateTime?
  resumeAttemptOrderId            String?
  resumeAttemptBillingAttemptId   String?
  resumeAttemptRetryNumber        Int       @default(1)
  resumeAttemptLastFailedBillingAttemptId String?
  preferredDeliveryWeekday                Int?
  nextScheduledDeliveryDate               String?   @db.VarChar(10)
  subscriptionCreatedEmailSentAt          DateTime?
  subscriptionPausedEmailSentAt           DateTime?
  mealSelectionLastExplicitDeliveryDate   String?   @db.VarChar(10)
  mealSelectionConfirmedEmailSentAt       DateTime?
  mealSelectionConfirmedDeliveryDate      String?   @db.VarChar(10)
  mealSelectionReminderEmailSentAt        DateTime?
  mealSelectionReminderDeliveryDate       String?   @db.VarChar(10)
  createdAt                       DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  paymentRecoveries SubscriptionPaymentRecovery[]

  @@unique([shop, shopifyOrderId])
  @@unique([shop, subscriptionContractId])
  @@index([shop, customerShopifyId])
  @@index([shop, subscriptionContractId])
}

model SubscriptionPaymentRecovery {
  id                          String   @id @default(cuid())
  shop                        String
  subscriptionMealSelectionId String
  billingCycleKey             String
  failureCount                Int      @default(0)
  status                      String
  nextRetryAt                 DateTime?
  lastFailureAt               DateTime?
  lastErrorCode               String?
  lastErrorMessage            String?
  lastBillingAttemptId        String?
  paymentUpdateEmailSentAt    DateTime?
  paymentFailedEmailSentAt    DateTime?
  paymentRecoveredEmailSentAt DateTime?
  finalPausedAt               DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  subscriptionMealSelection SubscriptionMealSelection @relation(fields: [subscriptionMealSelectionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionMealSelectionId, billingCycleKey])
  @@index([shop, status, nextRetryAt])
}

// Pre-checkout prospect capture. convertedAt is reserved for a later order-webhook
// pass (13I/13J) — 13H never sets it. Abandoned leads may later need a retention purge.
model CheckoutLead {
  id                    String    @id @default(cuid())
  shop                  String
  email                 String
  objective             String?
  boxVariantId          String?
  mealCount             Int?
  scheduledDeliveryDate String?   @db.VarChar(10)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastSeenAt            DateTime  @default(now())
  convertedAt           DateTime?

  @@unique([shop, email])
  @@index([shop, lastSeenAt])
}
